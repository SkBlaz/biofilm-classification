# Biofilm Classification Environment Configuration
#
# This file contains environment variables used by docker-compose.yml
# to configure volume mounts and paths for the biofilm classification pipeline.
#
# Copy this file to .env and modify the paths according to your setup.

# Main workflow paths
# -------------------
# Path to folder containing .tif images for training/feature generation
IMAGINE_IMAGES=./training_images

# Path to folder where all results will be stored (features, models, visualizations)
IMAGINE_RESULTS=./results

# Inference-specific paths
# ------------------------
# Path to folder containing .tif images for inference (classification of new images)
IMAGINE_INFERENCE_INPUTS=./new_images_to_classify

# Path to folder where inference results will be saved
IMAGINE_INFERENCE_OUTPUTS=./inference_results

# Example workflow:
# 1. Set IMAGINE_IMAGES and IMAGINE_RESULTS for training
# 2. Run: docker compose run --rm imagine 4 datafile.tsv 10 learning_benchmark_save_models
# 3. Set IMAGINE_INFERENCE_INPUTS and IMAGINE_INFERENCE_OUTPUTS for inference
# 4. Run: docker compose run --rm imagine 4 - 10 inference
#
# Models will be loaded from ${IMAGINE_RESULTS}/models
# Input images will be read from ${IMAGINE_INFERENCE_INPUTS}
# Results will be saved to ${IMAGINE_INFERENCE_OUTPUTS}